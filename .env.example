# FUSE Iraq — environment variable names only (never put real secrets here).
# Copy to .env.local for local scripts. Vercel/Codemagic set production values in their consoles.

# --- Optional web Firebase overrides (defaults are baked into app/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Staff Auth passwords (required for staff login tests / sync scripts) ---
STAFF_ADMIN_PASSWORD=
STAFF_RESTAURANT_PASSWORD=
STAFF_DRIVER_PASSWORD=

# --- Customer E2E (required for npm run test:e2e-lifecycle) ---
FUSE_E2E_EMAIL=fuse.e2e.launch.083026@gmail.com
E2E_CUSTOMER_PASSWORD=
# FUSE_E2E_PASSWORD=   # alias accepted by E2E scripts

# --- Firebase Admin / CLI (seed, provision, deploy rules) ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FUSE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# --- Android release signing (local or Codemagic; never commit keystore/passwords) ---
# FUSE_KEYSTORE_FILE=upload-keystore.jks
# FUSE_KEYSTORE_PASSWORD=
# FUSE_KEY_ALIAS=upload
# FUSE_KEY_PASSWORD=
