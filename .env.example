# FUSE Iraq — variable NAMES only. Never put real secrets in this file.
# Copy to .env.local for local scripts. Set production values in Vercel / Codemagic consoles.

# =============================================================================
# Local development (optional Firebase web overrides)
# Defaults are already embedded in app/firebase.ts for the public web SDK.
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# E2E / automated lifecycle tests (do not invent values)
# =============================================================================
FUSE_E2E_EMAIL=fuse.e2e.launch.083026@gmail.com
E2E_CUSTOMER_PASSWORD=
# FUSE_E2E_PASSWORD=          # alias accepted by some E2E scripts

# =============================================================================
# Staff Auth passwords (login verification / sync scripts only)
# Staff authorization in the app uses Firebase custom claims or Firestore profile
# role fields — never email alone.
# =============================================================================
STAFF_ADMIN_PASSWORD=
STAFF_RESTAURANT_PASSWORD=
STAFF_DRIVER_PASSWORD=

# =============================================================================
# Firebase Admin / CLI (seed, provision staff, deploy rules)
# =============================================================================
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FUSE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# =============================================================================
# Android release signing (local or Codemagic — never commit keystore/passwords)
# =============================================================================
# FUSE_KEYSTORE_FILE=upload-keystore.jks
# FUSE_KEYSTORE_PASSWORD=
# FUSE_KEY_ALIAS=upload
# FUSE_KEY_PASSWORD=
# CM_KEYSTORE_PATH=             # Codemagic file-secret path when provided by CI

# =============================================================================
# iOS / Codemagic secrets (configured in Codemagic UI — not in git)
# =============================================================================
# App Store Connect integration name, signing certificates, and provisioning
# profiles are managed in Codemagic / Apple Developer. Do not store them here.

# =============================================================================
# Vercel (configured in Vercel project settings — not in git)
# =============================================================================
# Production Firebase web config may use NEXT_PUBLIC_* overrides above.
# Never put service-account JSON or private keys in Vercel public env vars.
