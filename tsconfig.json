{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "backups",
    "backups/**",
    ".fuse-backups/**",
    "android/app/src/main/assets/public/**",
    ".fuse-tools",
    "android/.gradle",
    "ios/App/App/public",
    "ios/App/App/public/**",
    "android/.gradle/**",
    ".fuse-tools/**",
    "android/app/build",
    "android/app/build/**",
    "android/app/src/main/assets/public",
    "ios/App/Pods",
    "ios/App/Pods/**",
    ".fuse-backups"
  ]
}
