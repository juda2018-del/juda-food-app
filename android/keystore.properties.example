# Copy to android/app/keystore.properties (gitignored) for local release builds.
# Provide the keystore via a local path or FUSE_KEYSTORE_FILE. Never commit *.jks.
# CI: set FUSE_KEYSTORE_FILE, FUSE_KEYSTORE_PASSWORD, FUSE_KEY_ALIAS, FUSE_KEY_PASSWORD.
storeFile=../local-upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
