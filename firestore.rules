rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() {
      return !signedIn() ? ''
        : request.auth.token.role is string ? request.auth.token.role
        : request.auth.token.fuseRole is string ? request.auth.token.fuseRole
        : hasProfile() && profile().role is string ? profile().role
        : hasProfile() && profile().fuseRole is string ? profile().fuseRole
        : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isRestaurant() { return role() == 'restaurant'; }
    function isDriver() { return role() == 'driver'; }
    function isCustomer() { return role() == 'customer'; }
    function restaurantId() {
      return !signedIn() ? ''
        : request.auth.token.restaurantId is string ? request.auth.token.restaurantId
        : hasProfile() && profile().restaurantId is string ? profile().restaurantId
        : '';
    }
    function customerOwns(data) { return signedIn() && data.customerUid == request.auth.uid; }
    function restaurantOwns(data) { return isRestaurant() && restaurantId() != '' && data.restaurantId == restaurantId(); }
    function driverOwns(data) {
      return isDriver() && ((data.driverUid is string && data.driverUid == request.auth.uid) || (data.driverId is string && data.driverId == request.auth.uid));
    }
    function restaurantExists(id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/restaurants/$(id)); }
    function restaurantAccepts(id) {
      let r = get(/databases/$(database)/documents/restaurants/$(id)).data;
      return r.active != false && r.open != false && r.isOpen != false && r.status != 'مغلق';
    }
    function validOrder() {
      return isCustomer()
        && request.resource.data.keys().hasAll(['orderId','customerUid','customerName','phone','address','restaurantId','restaurantName','items','subtotal','deliveryFee','total','currency','status','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.orderId is string && request.resource.data.orderId.size() >= 8 && request.resource.data.orderId.size() <= 40
        && request.resource.data.customerName is string && request.resource.data.customerName.size() >= 2 && request.resource.data.customerName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^07[0-9]{9}$')
        && request.resource.data.address is string && request.resource.data.address.size() >= 8 && request.resource.data.address.size() <= 220
        && restaurantExists(request.resource.data.restaurantId) && restaurantAccepts(request.resource.data.restaurantId)
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number && request.resource.data.deliveryFee is number && request.resource.data.total is number
        && request.resource.data.subtotal >= 0 && request.resource.data.deliveryFee >= 0
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee
        && request.resource.data.currency == 'IQD' && request.resource.data.status == 'جديد';
    }
    function validApplication(kind) {
      return isCustomer() && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.kind == kind && request.resource.data.status == 'pending'
        && request.resource.data.applicantName is string && request.resource.data.applicantName.size() >= 2 && request.resource.data.applicantName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^07[0-9]{9}$')
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 80
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 1000;
    }

    match /restaurants/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isRestaurant() && id == restaurantId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','phone','address','logo','cover','open','isOpen','status','deliveryFee','minimumOrder','workingHours','updatedAt']));
    }
    match /menu/{id} {
      allow read: if true;
      allow create: if isAdmin() || (isRestaurant() && restaurantId() != '' && request.resource.data.restaurantId == restaurantId());
      allow update: if isAdmin() || (isRestaurant() && restaurantId() != '' && resource.data.restaurantId == restaurantId() && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if isAdmin() || (isRestaurant() && restaurantId() != '' && resource.data.restaurantId == restaurantId());
    }
    match /orders/{id} {
      allow create: if validOrder();
      allow read: if isAdmin() || customerOwns(resource.data) || restaurantOwns(resource.data) || driverOwns(resource.data);
      allow update: if isAdmin()
        || (restaurantOwns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','acceptedAt','rejectedAt','readyAt','preparingAt','restaurantNote']))
        || (driverOwns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','pickedUpAt','deliveredAt','driverLatitude','driverLongitude','driverLocationUpdatedAt']));
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow create: if isCustomer()
        && request.resource.data.keys().hasAll(['type','audience','title','message','customerUid','restaurant','restaurantName','restaurantId','phone','orderId','orderDocumentId','read','createdAt'])
        && request.resource.data.keys().hasOnly(['type','audience','title','message','customerUid','restaurant','restaurantName','restaurantId','phone','orderId','orderDocumentId','read','createdAt'])
        && request.resource.data.type == 'order'
        && request.resource.data.audience == 'restaurant'
        && request.resource.data.title == 'طلب جديد'
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 220
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^07[0-9]{9}$')
        && request.resource.data.orderId is string
        && request.resource.data.orderDocumentId is string
        && request.resource.data.read == false
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.customerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.orderId == request.resource.data.orderId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.restaurantId == request.resource.data.restaurantId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.restaurantName == request.resource.data.restaurantName
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.restaurantName == request.resource.data.restaurant
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderDocumentId)).data.phone == request.resource.data.phone;
      allow read: if isAdmin() || (isRestaurant() && restaurantId() != '' && resource.data.restaurantId == restaurantId());
      allow update: if isAdmin() || (isRestaurant() && restaurantId() != '' && resource.data.restaurantId == restaurantId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }
    match /ratings/{orderId} {
      allow create: if isCustomer() && request.resource.data.orderDocumentId == orderId && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.restaurantRating is int && request.resource.data.restaurantRating >= 1 && request.resource.data.restaurantRating <= 5
        && request.resource.data.driverRating is int && request.resource.data.driverRating >= 0 && request.resource.data.driverRating <= 5
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status in ['تم التسليم','delivered']
        && request.resource.data.restaurantId == get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId
        && !exists(/databases/$(database)/documents/ratings/$(orderId));
      allow read: if isAdmin() || (isCustomer() && resource.data.customerUid == request.auth.uid) || (isRestaurant() && resource.data.restaurantId == restaurantId()) || (isDriver() && resource.data.driverUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer' && !request.resource.data.keys().hasAny(['restaurantId','fuseRole','permissions']);
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoURL','address','updatedAt']);
      allow delete: if isAdmin();
    }
    match /accounts/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer' && !request.resource.data.keys().hasAny(['restaurantId','fuseRole','permissions']);
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoURL','address','updatedAt']);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /driverApplications/{uid} {
      allow create: if uid == request.auth.uid && validApplication('driver') && request.resource.data.vehicleType is string && request.resource.data.vehicleType in ['دراجة نارية','سيارة','دراجة هوائية'];
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /restaurantApplications/{uid} {
      allow create: if uid == request.auth.uid && validApplication('restaurant')
        && request.resource.data.restaurantName is string && request.resource.data.restaurantName.size() >= 2 && request.resource.data.restaurantName.size() <= 120
        && request.resource.data.restaurantAddress is string && request.resource.data.restaurantAddress.size() >= 8 && request.resource.data.restaurantAddress.size() <= 220;
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /accountDeletionRequests/{uid} {
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && uid == request.auth.uid
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason','status','requestedAt','updatedAt']));
      allow delete: if isAdmin();
    }
    match /drivers/{id} { allow read: if isAdmin() || (isDriver() && request.auth.uid == id); allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
